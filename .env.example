# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard under Project Settings -> API.
# The anon key is safe to expose to the browser (that's how Supabase's
# client-side model works) -- access is controlled by Row Level Security
# policies in supabase/schema.sql, not by keeping this key secret.
#
# NEVER put the service_role key here or anywhere in this app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Powers the AI Coach chat (src/app/api/coach/route.ts).
# Never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional overrides.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
# FUTUREOS_MODEL=claude-opus-5
