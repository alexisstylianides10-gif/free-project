{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Touchline Manager",
  "version": "0.1.0",
  "identifier": "app.touchline.manager",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3210",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Touchline Manager", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 680, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SimulationGame",
    "shortDescription": "Offline football management simulator",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
